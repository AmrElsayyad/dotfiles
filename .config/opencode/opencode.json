  "plugins": [
    {
      "package": "@omniroute/opencode-plugin-v2",
      "options": {
        "providerId": "omniroute",
        "baseURL": "http://localhost:20128"
      }
    },
    "@dietrichgebert/ponytail",
    "@tarquinen/opencode-dcp",
    "@zilliz/memsearch-opencode"
  ],
  "mcp": {
    "servers": {
      "codebase-memory-mcp": {
        "command": ["codebase-memory-mcp", "mcp"],
        "type": "local"
      },
      "codegraph": {
        "type": "local",
        "command": ["codegraph", "serve", "--mcp"],
        "codemode": false
      },
      "skillspector": {
        "command": ["skillspector", "mcp"],
        "type": "local"
      },
      "serena": {
        "type": "local",
        "command": [
          "uvx",
          "--from",
          "serena-agent",
          "serena",
          "start-mcp-server",
          "--project-from-cwd",
          "--context",
          "agent",
          "--open-web-dashboard",
          "False"
        ]
      },
      "rea": {
        "type": "local",
        "command": ["npx", "-y", "rea-agents@6.7.0", "mcp"]
      }
    }
  },
  "providers": {
    "omniroute": {
      "name": "OmniRoute",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "http://localhost:20128/v1"
      },
      "models": {
        "my-combo": {
          "name": "my-combo"
        }
      },
      "body": {
        "max_tokens": 25000
      }
    },
    "openrouter": {
      "body": {
        "max_tokens": 25000
      }
    }
  }
}
