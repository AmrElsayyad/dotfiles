R9X        SEPARATE    ["cat <<\"cat x)\" $(echo","cat x)","cat it's","cat x)","printf PWNED-R9X"]
R9Xbt      SEPARATE    ["cat <<\"cat x)\" `echo","cat x`","cat it's","cat x)","printf PWNED-R9Xbt"]
R9X2       SEPARATE    ["cat <<\"pwd)\" $(echo","pwd)","cat it's","pwd)","printf PWNED-R9X2"]
R9Xctl     SILENT-CAT  ["cat <<\"cat x)\" x","cat x)","cat it's\ncat x)\nprintf PWNED-R9Xctl"]
C1         SEPARATE    ["cat <<$'\\c'","cat it's","\\c","printf PWNED-C1"]
C1x        SEPARATE    ["cat <<$'\\c'X","cat it's","\\cX","printf PWNED-C1x"]
C1m        SEPARATE    ["cat <<$'a\\c'","cat it's","a\\c","printf PWNED-C1m"]
C1cc       SEPARATE    ["cat <<$'E\\c\\c'","cat it's","E<1c>c","printf PWNED-C1cc"]
C1nb       SILENT-CAT  ["cat <<$'\\c'","cat it's\n<07>\nprintf PWNED-C1nb"]
C1nc       SILENT-CAT  ["cat <<$'\\c'","cat it's\nc\nprintf PWNED-C1nc"]
CQ         SEPARATE    ["cat <<$'E\\c\\''","cat it's\nE<1c>'","printf PWNED-CQ"]
CQs        SEPARATE    ["cat <<$'E\\c\\''","cat it's\nx'y","E<1c>'\nprintf PWNED-CQs"]
CQ2        SILENT-CAT  ["cat <<$'cat \\c\\''","x","cat <1c>'\nprintf PWNED-CQ2"]
CN         SILENT-CAT  ["cat <<$'E\\c\\nOF'","cat it's\nE<1c>nOF\nprintf PWNED-CN"]
X01        SEPARATE    ["cat <<$'E\\x01OF'","cat it's","E<01><01>OF","printf PWNED-X01"]
X7F        SEPARATE    ["cat <<$'E\\x7fOF'","cat it's","E<01><7f>OF","printf PWNED-X7F"]
OCT01      SEPARATE    ["cat <<$'E\\001OF'","cat it's","E<01><01>OF","printf PWNED-OCT01"]
RAW01      SEPARATE    ["cat <<$'E<01>OF'","cat it's","E<01><01>OF","printf PWNED-RAW01"]
RAW7F      SEPARATE    ["cat <<$'E<7f>OF'","cat it's","E<01><7f>OF","printf PWNED-RAW7F"]
DQ01       SEPARATE    ["cat <<\"E<01>OF\"","cat it's","E<01><01>OF","printf PWNED-DQ01"]
SQ01       SEPARATE    ["cat <<'E<01>OF'","cat it's","E<01><01>OF","printf PWNED-SQ01"]
CA         SEPARATE    ["cat <<$'E\\cAOF'","cat it's","E<01><01>OF","printf PWNED-CA"]
CB         SEPARATE    ["cat <<$'E\\cBOF'","cat it's","E\u0002OF","printf PWNED-CB"]
CAT        SEPARATE    ["cat <<$'E\\c@OF'","cat it's","E","printf PWNED-CAT"]
X01neg     SILENT-CAT  ["cat <<$'E\\x01OF'","cat it's\nE<01>OF\nprintf PWNED-X01n"]
PLAIN01    SEPARATE    ["cat <<E<01>OF","cat it's","E<01>OF","printf PWNED-PLAIN01"]
