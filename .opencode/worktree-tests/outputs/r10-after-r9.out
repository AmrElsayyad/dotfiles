A1-oct SEPARATE ["cat <<$'E\\0OF'","cat it's","E","printf PWNED-A1"]
A2-hex SEPARATE ["cat <<$'\\x00EOF'","cat it's","printf PWNED-A2"]
A3-uni SEPARATE ["cat <<$'\\u0000EOF'","cat it's","printf PWNED-A3"]
A4-U8 SEPARATE ["cat <<$'\\U00000000EOF'","cat it's","printf PWNED-A4"]
A5-cc SEPARATE ["cat <<$'E\\c@OF'","cat it's","E","printf PWNED-A5"]
A6-prefix SEPARATE ["cat <<XE$'\\0OF'","cat it's","XE","printf PWNED-A6"]
A7-suffix SEPARATE ["cat <<$'E\\0OF'Y","cat it's","EY","printf PWNED-A7"]
A8-trail SEPARATE ["cat <<$'EOF\\0'","cat it's","EOF","printf PWNED-A8"]
A9-full-neg SEPARATE ["cat <<$'E\\0OF'","EOF","E","printf PWNED-A9"]
A10-two SEPARATE ["cat <<$'E\\0\\x00OF'","cat it's","E","printf PWNED-A10"]
B1-cr SEPARATE ["cat <<EOF","cat it's","EOF","printf PWNED-B1"]
B2-vt SEPARATE ["cat <<E\u000bOF","cat it's","E\u000bOF","printf PWNED-B2"]
B3-ff SEPARATE ["cat <<E\fOF","cat it's","E\fOF","printf PWNED-B3"]
B4-nbsp SEPARATE ["cat <<E OF","cat it's","E OF","printf PWNED-B4"]
B5-u2028 SEPARATE ["cat <<E OF","cat it's","E OF","printf PWNED-B5"]
B6-u2029 SEPARATE ["cat <<E OF","cat it's","E OF","printf PWNED-B6"]
B7-subshell SEPARATE ["(cat <<EOF)","cat it's","EOF","printf PWNED-B7"]
B8-close-paren SEPARATE ["cat <<EOF)","cat it's","EOF","printf PWNED-B8"]
B9-cr-neg SILENT-CAT ["cat <<EOF","cat it's\nEOF\nprintf PWNED-B9"]
B10-crx SEPARATE ["cat <<EOF\rX","cat it's","EOF\rX","printf PWNED-B10"]
B11-cr-hash SEPARATE ["cat\r#","printf PWNED-B11"]
B12-vt-hash SEPARATE ["cat\u000b#","printf PWNED-B12"]
cm-plain-comment SEPARATE ["echo hi","printf PWNED-cm"]
D9 SEPARATE ["cat <<$'EOF'","cat it's","EOF","printf PWNED-D9"]
D10 SEPARATE ["cat <<pwd","cat body\\","pwd","cat it's","pwd","printf PWNED-D10"]
sub1 SEPARATE ["cat <<$(echo EOF)","cat it's","$(echo EOF)","printf PWNED-sub1"]
bt1 SEPARATE ["cat <<`echo EOF`","cat it's","`echo EOF`","printf PWNED-bt1"]
dqnest SEPARATE ["cat <<\"$(echo \"x\")\"","cat it's","$(echo x)","printf PWNED-dqnest"]
subnl SILENT-CAT ["cat <<$(echo","EOF)","cat it's\nprintf PWNED-subnl"]
innerredir SILENT-CAT ["cat <<$(echo x <<Y)","cat it's\nprintf PWNED-innerredir"]
R8C SILENT-CAT ["cat <<$(echo <<Y )","cat it's\n$(echo <<Y )\nprintf PWNED-R8C"]
