sub1 SEPARATE ["cat <<$(echo EOF)","cat it's","$(echo EOF)","printf PWNED-sub1"]
sub1-join SEPARATE ["cat <<$(echo EOF)","z","$(ech\\","o EOF)","printf J-sub1"]
sub1q SEPARATE ["cat <<$(echo 'EOF')","cat it's","$(echo 'EOF')","printf PWNED-sub1q"]
sub1q-join SEPARATE ["cat <<$(echo 'EOF')","z","$(echo\\","'EOF')","printf J-sub1q"]
sub1dq SEPARATE ["cat <<$(echo \"EOF\")","cat it's","$(echo \"EOF\")","printf PWNED-sub1dq"]
sub1dq-join SEPARATE ["cat <<$(echo \"EOF\")","z","$(echo\\","\"EOF\")","printf J-sub1dq"]
subnest SEPARATE ["cat <<$(echo $(echo EOF))","cat it's","$(echo $(echo EOF))","printf PWNED-subnest"]
subnest-join SEPARATE ["cat <<$(echo $(echo EOF))","z","$(echo $(\\","echo EOF))","printf J-subnest"]
bt1 SEPARATE ["cat <<`echo EOF`","cat it's","`echo EOF`","printf PWNED-bt1"]
bt1-join SEPARATE ["cat <<`echo EOF`","z","`echo\\","EOF`","printf J-bt1"]
bt1q SEPARATE ["cat <<`echo 'EOF'`","cat it's","`echo 'EOF'`","printf PWNED-bt1q"]
bt1q-join SEPARATE ["cat <<`echo 'EOF'`","z","`echo \\","'EOF'`","printf J-bt1q"]
bt1dq SEPARATE ["cat <<`echo \"EOF\"`","cat it's","`echo \"EOF\"`","printf PWNED-bt1dq"]
bt1dq-join SEPARATE ["cat <<`echo \"EOF\"`","z","`echo \\","\"EOF\"`","printf J-bt1dq"]
subE SEPARATE ["cat <<E$(F)","cat it's","E$(F)","printf PWNED-subE"]
subE-join SEPARATE ["cat <<E$(F)","z","E$\\","(F)","printf J-subE"]
par1 SEPARATE ["x=EOF","cat <<${x}","cat it's","${x}","printf PWNED-par1"]
par1-join SEPARATE ["x=EOF","cat <<${x}","z","${\\","x}","printf J-par1"]
par2 SEPARATE ["x=EOF","cat <<$x","cat it's","$x","printf PWNED-par2"]
par2-join SEPARATE ["x=EOF","cat <<$x","z","$\\","x","printf J-par2"]
arith SEPARATE ["cat <<$((1+1))","cat it's","$((1+1))","printf PWNED-arith"]
arith-join SEPARATE ["cat <<$((1+1))","z","$((1\\","+1))","printf J-arith"]
outerdq SEPARATE ["cat <<\"$(echo EOF)\"","cat it's","$(echo EOF)","printf PWNED-outerdq"]
outerdq-join SEPARATE ["cat <<\"$(echo EOF)\"","z","$(ech\\\no EOF)","printf J-outerdq"]
subspace SEPARATE ["cat <<$(echo EO F)","cat it's","$(echo EO F)","printf PWNED-subspace"]
subspace-join SEPARATE ["cat <<$(echo EO F)","z","$(echo\\","EO F)","printf J-subspace"]
subspaceq SEPARATE ["cat <<$(echo 'EO F')","cat it's","$(echo 'EO F')","printf PWNED-subspaceq"]
subspaceq-join SEPARATE ["cat <<$(echo 'EO F')","z","$(echo \\","'EO F')","printf J-subspaceq"]
mixsuffix SEPARATE ["cat <<$(echo EOF)X","cat it's","$(echo EOF)X","printf PWNED-mixsuffix"]
mixsuffix-join SEPARATE ["cat <<$(echo EOF)X","z","$(echo\\","EOF)X","printf J-mixsuffix"]
subbs SEPARATE ["cat <<$(echo \\$x)","cat it's","$(echo \\$x)","printf PWNED-subbs"]
subbs-join SEPARATE ["cat <<$(echo \\$x)","z","$(ech\\","o \\$x)","printf J-subbs"]
subnl SILENT-CAT ["cat <<$(echo","EOF)","cat it's\nprintf PWNED-subnl"]
innerredir SILENT-CAT ["cat <<$(echo x <<Y)","cat it's\nprintf PWNED-innerredir"]
subdash SEPARATE ["cat <<-$(echo EOF)","cat it's","$(echo EOF)","printf PWNED-subdash"]
subdash-join SEPARATE ["cat <<-$(echo EOF)","z","$(ech\\","o EOF)","printf J-subdash"]
btE SEPARATE ["cat <<E`echo OF`","cat it's","E`echo OF`","printf PWNED-btE"]
btE-join SEPARATE ["cat <<E`echo OF`","z","E`ech\\","o OF`","printf J-btE"]
dqnest SEPARATE ["cat <<\"$(echo \"x\")\"","cat it's","$(echo x)","printf PWNED-dqnest"]
dqnest-join SEPARATE ["cat <<\"$(echo \"x\")\"","z","$(ec\\\nho x)","printf J-dqnest"]
dqb SEPARATE ["cat <<\"`echo \"x\"`\"","cat it's","`echo x`","printf PWNED-dqb"]
dqb-join SEPARATE ["cat <<\"`echo \"x\"`\"","z","`ech\\\no x`","printf J-dqb"]
